    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-MetricsConsumer-5b234a7d-5b3f-4c8e-9f0a-1234567890ab</UserSecretsId>
    <RootNamespace>LogMonitoring.Consumers.Metrics</RootNamespace>
