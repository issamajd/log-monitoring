{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "LogMonitoring": "Debug"
    }
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ConsumerGroupId": "logs-consumer-group",
    "LogsTopic": "telemetry-logs",
    "DlqTopic": "dlq"
  },
  "Elasticsearch": {
    "Url": "http://localhost:9200",
    "IndexAlias": "logs"
  }
}
