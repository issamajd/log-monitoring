# ---------------------------------------------------------------------------
# Session enrichment (optional). Copy to .env and fill in per deployment.
# .env is gitignored; .env.example is the only env file that is committed.
# ---------------------------------------------------------------------------

# "enabled" or "disabled". Default when unset: disabled.
SESSION_ENRICHMENT=disabled

# Read-only SQL Server login created by deploy/session-enrichment/01-*.sql.
# This account can EXECUTE exactly one stored procedure and read nothing else.
SESSION_ENRICHMENT_MSSQL_URL=sqlhost.customer.local:1433
SESSION_ENRICHMENT_MSSQL_DB=rndfwcore
SESSION_ENRICHMENT_MSSQL_USER=mon_session_lookup
# WARNING: Compose interpolates $VAR inside unquoted .env values, so a password
# containing "$" gets silently mangled. Single-quote the value ('p$ss') or
# escape each "$" as "$$" -- or generate a $-free password:
#   openssl rand -base64 32 | tr -d '$'
SESSION_ENRICHMENT_MSSQL_PASSWORD=

# Encrypts stored datasource passwords in grafana.db. Generate per deployment:
#   openssl rand -base64 32
GF_SECURITY_SECRET_KEY=
