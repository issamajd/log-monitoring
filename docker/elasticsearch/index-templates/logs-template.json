{
  "index_patterns": ["logs-*"],
  "template": {
    "settings": {
      "number_of_shards": 3,
      "number_of_replicas": 0,
      "index.lifecycle.name": "logs-policy",
      "index.lifecycle.rollover_alias": "logs",
      "index.refresh_interval": "5s",
      "index.translog.durability": "async",
      "index.translog.sync_interval": "5s",
      "analysis": {
        "analyzer": {
          "log_analyzer": {
            "type": "custom",
            "tokenizer": "standard",
            "filter": ["lowercase", "stop"]
          }
        }
      }
    },
    "mappings": {
      "dynamic": "true",
      "dynamic_templates": [
        {
          "strings_as_keywords": {
            "match_mapping_type": "string",
            "mapping": {
              "type": "keyword",
              "ignore_above": 1024
            }
          }
        }
      ],
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "time": {
          "type": "date"
        },
        "observed_timestamp": {
          "type": "date"
        },
        "message": {
          "type": "text",
          "analyzer": "log_analyzer",
          "fields": {
            "keyword": {
              "type": "keyword",
              "ignore_above": 32766
            }
          }
        },
        "body": {
          "type": "text",
          "analyzer": "log_analyzer"
        },
        "level": {
          "type": "keyword"
        },
        "severity_number": {
          "type": "integer"
        },
        "severity_text": {
          "type": "keyword"
        },
        "service_name": {
          "type": "keyword"
        },
        "service_version": {
          "type": "keyword"
        },
        "service_namespace": {
          "type": "keyword"
        },
        "host_name": {
          "type": "keyword"
        },
        "host_ip": {
          "type": "ip"
        },
        "environment": {
          "type": "keyword"
        },
        "deployment_environment": {
          "type": "keyword"
        },
        "trace_id": {
          "type": "keyword"
        },
        "span_id": {
          "type": "keyword"
        },
        "parent_span_id": {
          "type": "keyword"
        },
        "trace_flags": {
          "type": "integer"
        },
        "correlation_id": {
          "type": "keyword"
        },
        "request_id": {
          "type": "keyword"
        },
        "user_id": {
          "type": "keyword"
        },
        "session_id": {
          "type": "keyword"
        },
        "customer_id": {
          "type": "keyword"
        },
        "tenant_id": {
          "type": "keyword"
        },
        "exception": {
          "properties": {
            "type": {
              "type": "keyword"
            },
            "message": {
              "type": "text"
            },
            "stacktrace": {
              "type": "text",
              "index": false
            }
          }
        },
        "logger_name": {
          "type": "keyword"
        },
        "thread_id": {
          "type": "keyword"
        },
        "thread_name": {
          "type": "keyword"
        },
        "file_name": {
          "type": "keyword"
        },
        "file_line": {
          "type": "integer"
        },
        "method_name": {
          "type": "keyword"
        },
        "class_name": {
          "type": "keyword"
        },
        "http": {
          "properties": {
            "method": {
              "type": "keyword"
            },
            "url": {
              "type": "keyword"
            },
            "status_code": {
              "type": "integer"
            },
            "request_content_length": {
              "type": "long"
            },
            "response_content_length": {
              "type": "long"
            },
            "user_agent": {
              "type": "keyword"
            },
            "client_ip": {
              "type": "ip"
            }
          }
        },
        "db": {
          "properties": {
            "system": {
              "type": "keyword"
            },
            "name": {
              "type": "keyword"
            },
            "statement": {
              "type": "text"
            },
            "operation": {
              "type": "keyword"
            },
            "duration_ms": {
              "type": "float"
            }
          }
        },
        "attributes": {
          "type": "object",
          "dynamic": true
        },
        "resource": {
          "type": "object",
          "dynamic": true
        },
        "instrumentation_scope": {
          "properties": {
            "name": {
              "type": "keyword"
            },
            "version": {
              "type": "keyword"
            }
          }
        },
        "fingerprint": {
          "type": "keyword"
        },
        "occurrence_count": {
          "type": "integer"
        },
        "is_duplicate": {
          "type": "boolean"
        },
        "enrichment": {
          "properties": {
            "business_context": {
              "type": "object",
              "dynamic": true
            },
            "temporal": {
              "properties": {
                "is_business_hours": {
                  "type": "boolean"
                },
                "day_of_week": {
                  "type": "keyword"
                },
                "hour_of_day": {
                  "type": "integer"
                }
              }
            },
            "geo": {
              "properties": {
                "country": {
                  "type": "keyword"
                },
                "city": {
                  "type": "keyword"
                },
                "location": {
                  "type": "geo_point"
                }
              }
            }
          }
        }
      }
    }
  },
  "priority": 100
}
