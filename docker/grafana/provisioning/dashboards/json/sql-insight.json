              "datasource": {
                "type": "postgres",
                "uid": "timescaledb"
              },
              "refId": "A",
              "format": "time_series",
              "rawSql": "SELECT time_bucket('1 minute', time) AS \"time\",\n       dq_name AS metric,\n       SUM(increase) AS \"errors\"\nFROM (\n  SELECT time,\n         labels->>'dq.name' AS dq_name,\n         -- Cumulative counter: the increase is the difference from the series' previous export.\n         -- The SDK exports every minute while the process lives, so a drop or a long gap means the\n         -- process restarted and its running total began again from 0.\n         CASE WHEN LAG(time) OVER w IS NULL\n                OR time - LAG(time) OVER w > INTERVAL '5 minutes'\n                OR value < LAG(value) OVER w\n              THEN value\n              ELSE value - LAG(value) OVER w END AS increase\n  FROM metrics.raw_metrics\n  WHERE metric_name = 'rndfw.dq.errors'\n    AND time BETWEEN $__timeFrom()::timestamptz - INTERVAL '1 day' AND $__timeTo()\n    AND ('${service:raw}' = '*' OR service_name = '${service:raw}')\n  WINDOW w AS (PARTITION BY service_name, host_name, labels ORDER BY time)\n) s\nWHERE time BETWEEN $__timeFrom() AND $__timeTo()\nGROUP BY 1, 2 ORDER BY 1;",
              "editorMode": "code",
              "rawQuery": true,
              "sql": {
                "columns": [],
                "groupBy": [],
                "limit": 50
              }
            }
          ],
          "title": "DB query errors by data query",
          "type": "timeseries",
          "description": "Failed data-query executions per minute, from the rndfw.dq.errors counter, one line per DQ. The counter is cumulative (each export repeats the running total since the process started), so this sums the increase between exports and treats a drop or a gap of over 5 minutes as a restart."
        }
      ],
      "title": "DB errors (TimescaleDB metrics)",
      "type": "row"
    }
