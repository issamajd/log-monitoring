        {
          "datasource": {
            "type": "elasticsearch",
            "uid": "es-logs"
          },
          "refId": "A",
          "query": "level:ERROR AND _exists_:error_kind AND environment:$env AND service_name:$service AND (host_name:$host OR (NOT _exists_:host_name)) AND message:*$search* AND session_id:*$session_id* AND trace_id:*$trace_id* AND user_id:*$user*",
          "alias": "",
          "metrics": [
            {
              "id": "1",
              "type": "raw_data",
              "settings": {
                "size": "500",
                "order": "desc",
                "useTimeRange": true
              }
            }
          ],
          "bucketAggs": [],
          "timeField": "@timestamp"
        }
      ],
      "title": "Failures (one row per error)",
      "type": "table",
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "@timestamp",
                "error_kind",
                "user_id",
                "attributes.bp.name",
                "exception.type",
                "exception.message",
                "session_id",
                "trace_id"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "renameByName": {
              "attributes.bp.name": "bp",
              "user_id": "user"
            },
            "indexByName": {
              "@timestamp": 0,
              "error_kind": 1,
              "user_id": 2,
              "attributes.bp.name": 3,
              "exception.type": 4,
              "exception.message": 5,
              "session_id": 6,
              "trace_id": 7
            }
          }
        }
      ],
      "description": "One row per failure the application recorded. error_kind \"method\" is a business rejection the user saw as a message; \"system\" is an unexpected failure (the stack is in the trace and in the log record). Click trace_id to open every span of that request."
    },
